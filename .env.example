# WACA Loop — environment template.
# Copy to `.env` and fill in. Datasets are created in an existing or dedicated BigQuery project (§0).
#
# Organization-specific values (name, Workspace domains, unit ids, guard keywords, sheet
# unit map) live in org.toml, not here — copy org.example.toml to org.toml and replace every
# CHANGE-ME. To point at a different file:
# ORG_CONFIG=sample/org.toml
# On Cloud Run, mount org.toml from Secret Manager and set ORG_CONFIG (docs/SETUP_gcp.md §8).

# --- BigQuery ---
GCP_PROJECT=your-gcp-project
# Datasets created inside that project (<DS_*> are variable, §2.1):
DS_GROUNDING=waca_loop_grounding   # terms, persons, oauth_identity_map, embedding_model
DS_LEDGER=waca_loop_ledger         # usage_log
DS_FEEDBACK=waca_loop_feedback     # survey_responses, improvement_tasks, extraction_candidates
DS_KNOWLEDGE=waca_loop_knowledge   # questions, feedback — SFAQ (SPEC_phase2)
DS_INTEGRATION=waca_loop_integration          # source_items — 源泉エンベロープ (ARCHITECTURE_knowledge_layers)
BQ_LOCATION=US
# BigQuery -> Vertex remote connection used by the embedding model (CREATE MODEL).
# Create with: bq mk --connection --location=$BQ_LOCATION --connection_type=CLOUD_RESOURCE bq_vertex
# Value form: <project>.<location>.<connection_id>  (see docs/SETUP_gcp.md)
BQ_CONNECTION=your-project.US.bq_vertex

# --- Google OAuth (§5) ---
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Scopes: BigQuery R/W + user identity (openid email). Space-separated.
OAUTH_SCOPES="https://www.googleapis.com/auth/bigquery openid email"
OAUTH_TOKEN_STORE=.tokens/   # local token cache dir (gitignored)

# --- Embeddings (§2.3) ---
# bq_ml -> embeddings generated in BigQuery via CREATE MODEL (Vertex connection) +
#          ML.GENERATE_EMBEDDING. Japanese content -> multilingual model.
# EMBEDDING_MODEL is the Vertex endpoint used by sql/ddl/06_embedding_model.sql.
EMBEDDING_PROVIDER=bq_ml
EMBEDDING_MODEL=text-multilingual-embedding-002
EMBEDDING_DIM=768

# --- Hosted mode (Cloud Run) — leave unset for local stdio ---
# SERVER_MODE=http                # stdio (default) | http (Streamable HTTP behind OAuth)
# BQ_AUTH=adc                     # Cloud Run service account; users never hold BigQuery IAM
# MCP_PUBLIC_URL=https://...run.app   # public base URL = OAuth issuer + resource id (REQUIRED;
#                                 # the server is its own AS — auth/as_provider.py)
# PORT=8080                       # injected by Cloud Run
# MCP_TOKEN_SIGNING_KEY=...       # HMAC key(s) for self-contained AS tokens (auth/tokens.py).
#                                 # REQUIRED in http mode (serve_http fails closed); >=32 chars.
#                                 # Generate with `openssl rand -base64 48`; Secret Manager ONLY —
#                                 # whoever reads this key can mint tokens as any member.
#                                 # Graceful rotation: set to "newkey,oldkey" (first mints, all
#                                 # verify), drop the old key after 30 days (refresh TTL).
# In http mode OAUTH_CLIENT_ID/SECRET must be the **Web application** Google client (server-side
# code exchange); the Desktop client is stdio-only. Access gate = oauth_identity_map sub allowlist
# (registered members only) — no Workspace-domain restriction: members may sign in with
# accounts outside the organization's Workspace (e.g. gmail.com) once registered.

# --- Retention / monitor ---
USAGE_LOG_RETENTION_DAYS=730   # scan window (days) for full-ledger reads; rows are not auto-deleted
MONITOR_WINDOW_DAYS=7          # §7 positive-list lookback window

# セッションスコープ宣言の有効期限（時間）。0 で自動失効を無効にし、宣言し直す
# まで永続させる（SPEC_ops R1）
SCOPE_TTL_HOURS=12


# --- Survey / improvement loop ---
SURVEY_ATTRIBUTION=pseudonymous   # pseudonymous | identified | anonymous
SURVEY_CADENCE=monthly            # monthly | quarterly | weekly

# --- FLOOR-02 の上限超過・事前登録の hd 検査 ---
# どちらも org.toml で設定する（[units] export_admin / [org] workspace_domains）。
